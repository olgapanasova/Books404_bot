# --- ЛОГИКА ПОИСКА ---
@bot.message_handler(content_types=['text'])
def handle_text(message):
    user_text = message.text.lower()
    
    # Защита от тяжелых книг, если просят легкое
    wants_light = any(word in user_text for word in ["легк", "смешн", "романтик", "весел", "уютн", "смех", "отвлечься", "мил"])
    
    scores = {book: 0 for book in BOOKS_DATA}
    matched_tags_global = set()

    for book, data in BOOKS_DATA.items():
        if wants_light and data.get("level", 3) >= 3:
            continue
            
        for tag in data["tags"]:
            if tag in user_text:
                scores[book] += 1
                matched_tags_global.add(tag)

    max_score = max(scores.values())

    if max_score == 0:
        msg = "Я тебя услышал. Но в моей базе пока нет книги, которая идеально подходит под этот запрос. Скоро здесь появятся новые рекомендации."
    else:
        best_books = [book for book, score in scores.items() if score == max_score]
        best_book = best_books[0]
        data = BOOKS_DATA[best_book]
        
        msg = f"<b>Твоя ситуация больше всего похожа на книгу «{best_book}».</b>\n\n"
        msg += f"О чем она: {data['desc']}\n\n"
        msg += f"<i>Внимание: {data['warn']}</i>\n\n"

        best_book_matched_tags = {tag for tag in data['tags'] if tag in user_text}
        ignored_tags = matched_tags_global - best_book_matched_tags

        if ignored_tags:
            msg += "<i>P.S. Я заметил, что ты упоминал(а) другие темы (которые есть в других книгах), но в этой книге их нет. Я выбрал ту, где совпало больше всего твоих запросов.</i>"

    bot.send_message(message.chat.id, msg, parse_mode='HTML', reply_markup=get_back_button())

